#!/bin/sh
# live-build configuration of Ban OS (plan part 1, step 1.1).
# Run through `make build` (image/scripts/build-image.sh), not by hand.
#
# All build-time mirrors point at the local apt-cacher-ng (step 0.3) so the
# build never talks to the internet directly. BAN_APT_CACHE can point at a
# full local mirror instead.
#
# --firmware-chroot false: "true" installs every package in the archive that
# ships firmware, including firmware-b43*-installer (contrib), which download
# their firmware from the internet in postinst and break the offline build.
# Firmware comes only from image/packages/firmware.list.chroot (step 1.2).
#
# --bootappend-live: live-boot only (no live-config, see
# image/packages/live.list.chroot). The menu that actually boots is written by
# image/scripts/hooks/7100-ban-grub.hook.binary with the variant's kernel
# command line (BAN_KERNEL_CMDLINE in image/variants/<variant>/variant.env).

set -e

BAN_APT_CACHE="${BAN_APT_CACHE:-http://127.0.0.1:3142}"

lb config noauto \
  --distribution trixie --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "${BAN_APT_CACHE}/deb.debian.org/debian" \
  --mirror-chroot "${BAN_APT_CACHE}/deb.debian.org/debian" \
  --mirror-chroot-security "${BAN_APT_CACHE}/security.debian.org/debian-security" \
  --binary-images iso-hybrid --bootloaders grub-efi \
  --debian-installer none \
  --apt-recommends false --firmware-chroot false \
  --bootappend-live "boot=live" \
  --iso-application "Ban OS" --iso-volume "BANOS" \
  "${@}"
