# Build variables of the "pos" variant (plan part 1, step 0.8): the graphical
# POS image (LightDM autologin, kiosk session, Adad, Ban Center).
# Sourced by image/scripts/build-image.sh. Plain KEY=value, no secrets.
BAN_VARIANT=pos
# systemd default target of the installed system (Stage 2)
BAN_DEFAULT_TARGET=graphical.target
# Device roles the first-boot wizard offers (Stage 12)
BAN_DEVICE_ROLES="standalone server client"
