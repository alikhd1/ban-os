# Build variables of the "server" variant (plan part 1, step 0.8): the headless
# store server (PostgreSQL + Ban services, managed from ban-console on tty1).
# Sourced by image/scripts/build-image.sh. Plain KEY=value, no secrets.
BAN_VARIANT=server
# systemd default target of the installed system (Stage 2)
BAN_DEFAULT_TARGET=multi-user.target
# Device roles the first-boot wizard offers (Stage 12)
BAN_DEVICE_ROLES="server"
# Kernel command line (Stage 2, "Variant server"): no splash; kernel and the
# console UI also on the serial port (IPMI serial-over-LAN). Used by the ISO's
# GRUB menu and by /etc/default/grub.d/ban.cfg of the installed system.
BAN_KERNEL_CMDLINE="quiet loglevel=3 vt.global_cursor_default=0 panic=10 fsck.repair=yes console=tty0 console=ttyS0,115200n8"
# Extra GRUB entries besides "Ban OS": no Maintenance entry, the console is
# always behind a PIN
BAN_GRUB_ENTRIES="recovery"
# GRUB menu also on the first serial port
BAN_GRUB_SERIAL=true
