#!/bin/bash
# live-build's GRUB menu has no timeout and waits for a key forever, which
# blocks a headless `make test-boot`. Boot the default entry after 5 seconds.
# Stage 2 (step 2.1) replaces this with the hidden Ban OS menu.
# Runs on the build host in the binary/ directory.

set -euo pipefail

cfg=boot/grub/config.cfg
[[ -f "${cfg}" ]] || {
  echo "ban: ${cfg} not found; live-build layout changed?" >&2
  exit 1
}

if ! grep -q '^set timeout=' "${cfg}"; then
  printf '\n# Ban OS, Stage 1: boot the default entry after 5 s.\nset timeout=5\n' >> "${cfg}"
fi
