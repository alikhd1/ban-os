#!/bin/bash
# Profile-specific settings (plan part 1, step 0.6).
#
# development: the plan's `maintenance` user with full sudo and the
# well-known development password from config/development/profile.env, so
# the image can be inspected over the console or SSH. staging and production
# get no login user before Stage 2.

set -euo pipefail

# shellcheck source=/dev/null
source /live-build/config/ban/build.env

if [[ "${BAN_PROFILE}" != development ]]; then
  exit 0
fi

[[ -n "${BAN_DEV_MAINTENANCE_PASSWORD:-}" ]] || {
  echo "ban: BAN_DEV_MAINTENANCE_PASSWORD is not set in config/development/profile.env" >&2
  exit 1
}

if ! id maintenance > /dev/null 2>&1; then
  useradd --create-home --shell /bin/bash --groups sudo maintenance
fi
echo "maintenance:${BAN_DEV_MAINTENANCE_PASSWORD}" | chpasswd

echo "ban: development user 'maintenance' created"
