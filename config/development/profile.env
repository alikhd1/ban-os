# Build variables of the "development" profile (plan part 1, step 0.6).
# Sourced by image/scripts/build-image.sh. Plain KEY=value, no secrets.
BAN_PROFILE=development
BAN_SSH_ENABLED=true
BAN_ROOT_LOCKED=true
# full = unrestricted sudo for the maintenance user; whitelist = fixed command list
BAN_MAINTENANCE_SUDO=full
BAN_CENTER_DEVTOOLS=true
BAN_UPDATE_CHANNEL=dev
BAN_LOG_LEVEL=DEBUG
# A well-known default technician PIN is allowed on development images only.
BAN_DEFAULT_PIN_ALLOWED=true
# Password of the `maintenance` user on development images only (Stage 1,
# image/scripts/hooks/7010-ban-profile.hook.chroot). Publicly known on
# purpose: development images must never be installed in a store.
BAN_DEV_MAINTENANCE_PASSWORD=ban-dev
