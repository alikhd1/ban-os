# Build variables of the "production" profile (plan part 1, step 0.6).
# Sourced by image/scripts/build-image.sh. Plain KEY=value, no secrets.
BAN_PROFILE=production
BAN_SSH_ENABLED=false
BAN_ROOT_LOCKED=true
BAN_MAINTENANCE_SUDO=whitelist
BAN_CENTER_DEVTOOLS=false
BAN_UPDATE_CHANNEL=stable
BAN_LOG_LEVEL=INFO
BAN_DEFAULT_PIN_ALLOWED=false
